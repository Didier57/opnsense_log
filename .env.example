# ---------- Web / API ----------
WEB_PORT=8080
WEB_HOST=0.0.0.0
# Public URL used in links/redirects (optional)
PUBLIC_URL=
# 0.0.0.0 accepts remote syslog from OPNsense
SYSLOG_HOST=0.0.0.0

# ---------- Syslog receiver ----------
# First syslog port; OPNsense 1 sends here (configure it in OPNsense:
# System > Settings > Logging). Extra instances automatically use the next
# ports (5141, 5142, ...).
SYSLOG_PORT=5140
# Host port range published by docker-compose so every instance is reachable.
# Must start at (or before) SYSLOG_PORT and cover all your instances.
SYSLOG_PORT_START=5140
SYSLOG_PORT_END=5160
# udp | tcp | both
SYSLOG_PROTOCOL=udp
SYSLOG_QUEUE_MAXSIZE=100000
PARSER_WORKERS=2
BATCH_SIZE=1000
BATCH_FLUSH_MS=1000

# ---------- Storage ----------
DATA_DIR=/data
DB_FILENAME=opnsense.duckdb
# 7 | 30 | 90 | 180 | 365 | 0 (0 = unlimited retention)
LOG_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_MIN=60

# ---------- Authentication ----------
AUTH_ENABLED=true
# User accounts (admin / viewer) are created on the first launch (registration
# page) and managed in the web UI: Settings -> Users. No credentials are needed
# here. On a fresh install you may optionally pre-seed the first administrator
# from the environment by uncommenting the lines below (otherwise ignored):
# AUTH_USERNAME=admin
# AUTH_PASSWORD=
# AUTH_PASSWORD_HASH=
# Use a long random string in production
SECRET_KEY=change-me-in-production
TOKEN_EXPIRE_MINUTES=480

# ---------- Display ----------
DISPLAY_TIMEZONE=Europe/Luxembourg
# Timezone in which OPNsense emits syslog timestamps (firewall local time).
# Empty = use DISPLAY_TIMEZONE.
SYSLOG_TIMEZONE=Europe/Luxembourg
# INFO | WARNING | ERROR | DEBUG
LOG_LEVEL=INFO

# ---------- Hostname lookup (reverse DNS) ----------
# How long a resolved IP -> hostname mapping is cached before being looked up
# again (minutes). Used by the "Rechercher les noms d'hôtes" option in Live.
HOSTNAME_LOOKUP_TTL_MIN=1440

# ---------- OPNsense SSH ----------
# Configured from the web UI: Settings -> OPNsense (stored in the data volume).
# No environment variables are required.

# ---------- Detection engine ----------
# Configured from the web UI: Security -> Detection (stored in the data volume).
# No environment variables are required.

# ---------- Email notifications (SMTP) ----------
# Configured from the web UI: Settings -> Notifications (stored in the data volume).
# No environment variables are required.

