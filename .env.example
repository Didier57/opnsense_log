# =====================================================================
#  OPNsense Log Analyzer - environment file
#  Copy to ".env" next to docker-compose.yml, then edit the values
#  marked CHANGE_ME. Everything else can stay as is.
# =====================================================================

# ---------- Web / API ----------
# Host port of the web UI (container listens on 8080).
WEB_PORT=8080
# Bind address inside the container.
WEB_HOST=0.0.0.0
# Public URL used in links/redirects (optional, e.g. https://logs.example.com)
PUBLIC_URL=

# ---------- Syslog receiver ----------
# Address the container listens on (0.0.0.0 = accepts remote syslog).
SYSLOG_HOST=0.0.0.0
# First syslog port; OPNsense #1 sends here (OPNsense: System > Settings >
# Logging > Remote, UDP). Extra instances automatically use the next ports.
SYSLOG_PORT=5140
# Host port range published by docker-compose so every instance is reachable.
# Must start at (or before) SYSLOG_PORT and cover all your firewalls.
SYSLOG_PORT_START=5140
SYSLOG_PORT_END=5160
# udp | tcp | both
SYSLOG_PROTOCOL=udp
SYSLOG_QUEUE_MAXSIZE=100000
PARSER_WORKERS=2
BATCH_SIZE=1000
BATCH_FLUSH_MS=1000

# ---------- Storage ----------
DATA_DIR=/data
DB_FILENAME=opnsense.duckdb
# 7 | 30 | 90 | 180 | 365 | 0 (0 = unlimited retention)
LOG_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_MIN=60
# DuckDB memory ceiling PER database file. Without it DuckDB claims ~80% of
# the host RAM even when idle, which starves a small (4 GB) machine.
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2

# ---------- Authentication ----------
AUTH_ENABLED=true
# Secret used to sign session cookies. MUST be changed: generate one with
#   openssl rand -hex 32
# Changing it logs every user out (existing sessions become invalid).
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# Session length in minutes (10080 = 7 days). The session slides: every API
# call made in the second half of the window refreshes the cookie, so an
# actively used session never expires.
TOKEN_EXPIRE_MINUTES=10080
# Accounts (admin / viewer) are created on the first launch and managed in
# the UI: Settings > Users. The two variables below are only used to pre-seed
# the first administrator on a fresh install (optional):
# AUTH_USERNAME=admin
# AUTH_PASSWORD=
# AUTH_PASSWORD_HASH=

# ---------- Display ----------
# Timezone used to display timestamps in the UI.
DISPLAY_TIMEZONE=Europe/Luxembourg
# Timezone in which OPNsense emits syslog timestamps (firewall local time).
# Empty = use DISPLAY_TIMEZONE.
SYSLOG_TIMEZONE=Europe/Luxembourg
# INFO | WARNING | ERROR | DEBUG
LOG_LEVEL=INFO

# ---------- Hostname lookup (reverse DNS) ----------
# How long an IP -> hostname mapping is cached before a new lookup (minutes).
# Used by the "Rechercher les noms d'hôtes" option in the Live view.
HOSTNAME_LOOKUP_TTL_MIN=1440

# ---------- Configured from the web UI (stored in the data volume) ----------
# - OPNsense SSH / API credentials ....... Settings > OPNsense (per instance)
# - Detection engine (thresholds) ........ Security > Detection
# - Blocking (alias, TTL, escalation) .... Security > Detection
# - SMTP server .......................... Settings > SMTP
# - ntfy topic / token ................... Settings > SMTP
# - Geolocation (GeoIP / MaxMind) ........ Settings > GeoIP
# No environment variable is required for these.
