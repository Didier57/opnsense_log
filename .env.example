# ---------- Web / API ----------
WEB_PORT=8080
WEB_HOST=0.0.0.0
# Public URL used in links/redirects (optional)
PUBLIC_URL=
# 0.0.0.0 accepts remote syslog from OPNsense
SYSLOG_HOST=0.0.0.0

# ---------- Syslog receiver ----------
# Port OPNsense sends filterlog to (configure it in OPNsense: System > Settings > Logging)
SYSLOG_PORT=5140
# udp | tcp | both
SYSLOG_PROTOCOL=udp
SYSLOG_QUEUE_MAXSIZE=100000
PARSER_WORKERS=2
BATCH_SIZE=1000
BATCH_FLUSH_MS=1000

# ---------- Storage ----------
DATA_DIR=/data
DB_FILENAME=opnsense.duckdb
# 7 | 30 | 90 | 180 | 365 | 0 (0 = unlimited retention)
LOG_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_MIN=60

# ---------- Authentication ----------
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Simplest setup: set the password directly here.
AUTH_PASSWORD=admin
# Optional: to avoid storing the password in clear text, set an argon2 hash instead.
# Generate with: docker compose run --rm opnsense-log-analyzer python scripts/hash_password.py
# When set, AUTH_PASSWORD_HASH takes precedence over AUTH_PASSWORD.
AUTH_PASSWORD_HASH=
# Use a long random string in production
SECRET_KEY=change-me-in-production
TOKEN_EXPIRE_MINUTES=480

# ---------- Display ----------
DISPLAY_TIMEZONE=Europe/Luxembourg
# Timezone in which OPNsense emits syslog timestamps (firewall local time).
# Empty = use DISPLAY_TIMEZONE.
SYSLOG_TIMEZONE=Europe/Luxembourg
# INFO | WARNING | ERROR | DEBUG
LOG_LEVEL=INFO

# ---------- OPNsense SSH ----------
# Configured from the web UI: Settings -> OPNsense (stored in the data volume).
# No environment variables are required.
